{
  "name": "@mmogr/orrery",
  "version": "0.5.0",
  "description": "Small, exact mathematics for pages that draw their data: a graph's spectrum, heat and curvature, Kepler's problem, frame-rate-free motion, and the dense maths underneath, with the derivations.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmogr/orrery.git"
  },
  "homepage": "https://mmogr.github.io/orrery/",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "demo": "esbuild demo/main.ts --bundle --outdir=demo/out --servedir=demo",
    "demo:build": "esbuild demo/main.ts --bundle --minify --outdir=demo/out",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
